# Copy this file to .env, then set a strong unique password before starting.
# Run exactly one application instance against exactly one persistent Volume.
# A concurrent writer exits when it cannot lock /app/Volume/.xhs-downloader.lock.
XHS_ADMIN_USERNAME=admin
XHS_ADMIN_PASSWORD=
XHS_ADMIN_SESSION_TTL=12h

# Set true when the service is reached through production HTTPS. Secure
# cookies are intentionally not sent by browsers over plain HTTP.
XHS_SESSION_COOKIE_SECURE=false

# Container and host HTTP ports.
PORT=5556
XHS_PORT=5556

# SQLite must resolve inside XHS_VOLUME_DIR; symlink escapes are rejected so
# the database always shares the protected single-instance volume.
XHS_DATABASE_PATH=/app/Volume/Data/xhs.sqlite3

# Leave blank to generate and manage Data/secrets.key in the persistent volume.
# For an external Secret, set its in-container read-only path here. It must
# contain exactly 32 raw bytes and be readable by container UID/GID 10001.
XHS_SECRET_KEY_PATH=

XHS_REQUEST_TIMEOUT=15s
XHS_DOWNLOAD_TIMEOUT=30m
XHS_DOWNLOAD_IDLE_TIMEOUT=60s
XHS_ALLOW_PRIVATE_PROXY=false
XHS_MAX_BODY_BYTES=1048576

# Maximum bytes for each saved image/video resource (default: 2 GiB).
XHS_MAX_MEDIA_BYTES=2147483648

# Anonymous extraction admission. Authenticated administrators bypass these
# limits so public traffic cannot consume all parsing capacity.
XHS_PUBLIC_RATE_LIMIT_PER_MINUTE=12
XHS_PUBLIC_GLOBAL_RATE_LIMIT_PER_MINUTE=120
XHS_PUBLIC_MAX_CONCURRENCY=4
